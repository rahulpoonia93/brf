---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-bg" aria-hidden="true"></div>
  <div class="container page-hero-inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 96px 0 72px;
    color: #fff;
    overflow: hidden;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 15% 30%, rgba(201,123,47,0.28), transparent 55%),
      radial-gradient(ellipse at 85% 70%, rgba(45,42,107,0.5), transparent 55%),
      linear-gradient(135deg, #1e1b4b 0%, #2a2560 100%);
  }
  .page-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0);
    background-size: 24px 24px;
    opacity: 0.55;
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }
  .page-hero .eyebrow { color: var(--color-accent-soft); }
  .page-hero h1 {
    color: #fff;
    font-weight: 400;
    margin-bottom: 0.4em;
  }
  .page-hero .lede {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.6;
    margin: 0;
    max-width: 680px;
  }

  @media (max-width: 760px) {
    .page-hero { padding: 72px 0 56px; }
    .page-hero .lede { font-size: 1rem; }
  }
</style>
