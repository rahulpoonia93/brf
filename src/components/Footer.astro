---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand-row">
        <img src="/images/logo2.png" alt="BRF" />
        <strong>Brihati Reforms Foundation</strong>
      </div>
      <p>Working toward an egalitarian society — ending caste-based discrimination and advancing human rights for marginalized communities.</p>
    </div>

    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/programmes/">Programmes</a></li>
        <li><a href="/inspiration/">Our Inspiration</a></li>
        <li><a href="/obligation/">Obligation</a></li>
      </ul>
    </div>

    <div>
      <h4>Get Involved</h4>
      <ul>
        <li><a href="/donate/">Donate</a></li>
        <li><a href="/contact/">Contact Us</a></li>
      </ul>
    </div>

    <div>
      <h4>Reach Us</h4>
      <address>
        4, Arya Lane<br />
        Behind Jawa Hospital<br />
        Dabra Road, Hisar<br />
        Haryana — 125005
      </address>
      <p class="contact-line"><a href="mailto:brihatireformsfoundation@gmail.com">brihatireformsfoundation@gmail.com</a></p>
      <p class="contact-line"><a href="tel:+917988948085">+91 79889 48085</a></p>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Brihati Reforms Foundation. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: rgba(255,255,255,0.78);
    padding: 72px 0 24px;
    margin-top: 80px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 48px;
  }
  .site-footer h4 {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer li { margin-bottom: 10px; }
  .site-footer a {
    color: rgba(255,255,255,0.78);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }
  .site-footer a:hover { color: var(--color-accent-soft); }
  .site-footer p { color: rgba(255,255,255,0.72); font-size: 0.95rem; }
  .site-footer address { font-style: normal; font-size: 0.95rem; line-height: 1.7; margin-bottom: 14px; }
  .contact-line { margin: 4px 0; }

  .brand-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .brand-row img { width: 36px; height: 36px; filter: brightness(0) invert(1); opacity: 0.95; }
  .brand-row strong { color: #fff; font-family: var(--font-serif); font-size: 1.05rem; font-weight: 500; }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 0.85rem;
    color: rgba(255,255,255,0.55);
  }

  @media (max-width: 880px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
  }
  @media (max-width: 540px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
