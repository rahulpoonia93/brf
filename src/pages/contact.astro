---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Contact Us — Brihati Reforms Foundation">
  <PageHero
    eyebrow="Get In Touch"
    title="We'd love to hear from you."
    lede="Whether you want to volunteer, collaborate, or simply learn more about our work — reach out through whichever channel is easiest for you."
  />

  <section class="contact-sec">
    <div class="container">
      <div class="contact-grid">
        <a class="contact-card" href="mailto:brihatireformsfoundation@gmail.com">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="M3 7l9 6 9-6" />
            </svg>
          </div>
          <span class="role">Email</span>
          <h3>Drop us a line</h3>
          <p class="value">brihatireformsfoundation<wbr/>@gmail.com</p>
          <span class="link-arrow">Send email →</span>
        </a>

        <a class="contact-card" href="tel:+917988948085">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92V21a1 1 0 0 1-1.1 1 19.9 19.9 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.9 19.9 0 0 1 3.2 4.3 1 1 0 0 1 4.2 3h4.08a1 1 0 0 1 1 .75c.13.9.37 1.78.72 2.62a1 1 0 0 1-.22 1.06L8.1 9.1a16 16 0 0 0 6 6l1.68-1.68a1 1 0 0 1 1.06-.22c.84.35 1.72.59 2.62.72a1 1 0 0 1 .75 1z"/>
            </svg>
          </div>
          <span class="role">Phone</span>
          <h3>Give us a call</h3>
          <p class="value">+91 79889 48085</p>
          <span class="link-arrow">Call now →</span>
        </a>

        <div class="contact-card">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <span class="role">Address</span>
          <h3>Visit us</h3>
          <address>
            4, Arya Lane<br />
            Behind Jawa Hospital<br />
            Dabra Road, Hisar<br />
            Haryana — 125005
          </address>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <span class="eyebrow light">Want to contribute?</span>
        <h2>Support our ongoing programmes.</h2>
      </div>
      <div class="cta-actions">
        <a href="/donate/" class="btn btn-accent">Donate Now</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-sec { background: var(--color-bg); }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: var(--shadow-sm);
  }
  a.contact-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent-soft);
    color: inherit;
  }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--color-bg-alt);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .icon svg { width: 26px; height: 26px; }

  .role {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .contact-card h3 { margin: 0 0 6px; font-size: 1.3rem; }
  .value { font-size: 1.05rem; color: var(--color-ink); margin: 0 0 12px; word-break: break-word; }
  address { font-style: normal; line-height: 1.7; color: var(--color-ink-soft); }
  .link-arrow { font-size: 0.9rem; font-weight: 600; color: var(--color-primary); margin-top: auto; }
  a.contact-card:hover .link-arrow { color: var(--color-accent); }

  /* CTA BAND (shared style with homepage) */
  .cta-band {
    background: linear-gradient(135deg, var(--color-primary) 0%, #2d2a6b 100%);
    color: #fff;
    padding: 72px 0;
  }
  .cta-band h2 { color: #fff; }
  .eyebrow.light { color: var(--color-accent-soft); }
  .cta-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .cta-actions { display: flex; gap: 14px; justify-content: flex-end; flex-wrap: wrap; }

  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
    .cta-inner { grid-template-columns: 1fr; gap: 20px; }
    .cta-actions { justify-content: flex-start; }
  }
</style>
