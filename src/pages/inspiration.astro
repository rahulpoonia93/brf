---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const quotes = [
  {
    name: 'Dr. B. R. Ambedkar',
    image: '/images/ambedkar.png',
    quote: 'Caste system must be abolished, if not in my way then in your way.',
    cite: 'Annihilation of Caste, 1936',
  },
  {
    name: 'Netaji Subhas Chandra Bose',
    image: '/images/netaji.png',
    quote: 'A new society has to be built on the basis of equality. The caste system has to be abolished.',
    cite: 'Midnapore, Bengal — 21 Dec 1929',
  },
  {
    name: 'Mahatma Jyotiba Phule',
    image: '/images/Phule.png',
    quote: 'Education is the source of emancipation and empowerment — the foundation of an egalitarian society.',
    cite: 'A lifelong conviction',
  },
  {
    name: 'Mahatma Gandhi',
    image: '/images/Gandhi.png',
    quote: 'Caste has to go. The sooner the public opinion abolishes it, the better.',
    cite: '1935',
  },
];
---

<Layout title="Our Inspiration — Brihati Reforms Foundation">
  <PageHero
    eyebrow="Standing On Their Shoulders"
    title="Guided by thinkers who shaped modern India."
    lede="Across generations, India's greatest minds have spoken with one voice against caste. Their words are not relics — they are instructions."
  />

  <section class="quotes-sec">
    <div class="container">
      <div class="quotes">
        {quotes.map((q, i) => (
          <article class={`quote-card ${i % 2 === 0 ? '' : 'reverse'}`}>
            <div class="portrait">
              <img src={q.image} alt={q.name} loading="lazy" />
            </div>
            <div class="quote-body">
              <svg class="mark" aria-hidden="true" viewBox="0 0 48 32" fill="none">
                <path d="M0 32V18C0 8.06 6.73 1.19 20.18 0L22 3.89c-8.72 1.65-13.09 6.26-13.09 13.82H22V32H0zm26 0V18C26 8.06 32.73 1.19 46.18 0L48 3.89c-8.72 1.65-13.09 6.26-13.09 13.82H48V32H26z" fill="currentColor"/>
              </svg>
              <p class="q-text">{q.quote}</p>
              <div class="attribution">
                <strong>{q.name}</strong>
                <span>{q.cite}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .quotes-sec { background: var(--color-bg); }

  .quotes { display: grid; gap: 40px; max-width: 1040px; margin: 0 auto; }

  .quote-card {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 44px;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .quote-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .quote-card.reverse { grid-template-columns: 1fr 240px; }
  .quote-card.reverse .portrait { order: 2; }

  .portrait img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-bg-alt);
    box-shadow: var(--shadow-sm);
  }

  .quote-body { position: relative; }
  .mark {
    width: 40px;
    height: auto;
    color: var(--color-accent-soft);
    margin-bottom: 14px;
    display: block;
  }
  .q-text {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.45;
    color: var(--color-primary);
    font-style: italic;
    margin-bottom: 20px;
    font-weight: 400;
  }
  .attribution { display: flex; flex-direction: column; gap: 2px; }
  .attribution strong {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .attribution span {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 760px) {
    .quote-card,
    .quote-card.reverse {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px;
      text-align: center;
    }
    .quote-card.reverse .portrait { order: 0; }
    .portrait img { max-width: 160px; margin: 0 auto; }
    .mark { margin-left: auto; margin-right: auto; }
    .q-text { font-size: 1.2rem; }
    .attribution { align-items: center; }
  }
</style>
