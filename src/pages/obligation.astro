---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const obligations = [
  {
    tag: 'Constitution of India',
    title: 'Preamble of the Indian Constitution',
    body: `WE, THE PEOPLE OF INDIA, having solemnly resolved to constitute India into a SOVEREIGN SOCIALIST SECULAR DEMOCRATIC REPUBLIC and to secure to all its citizens: JUSTICE, social, economic and political; LIBERTY of thought, expression, belief, faith and worship; EQUALITY of status and of opportunity; and to promote among them all FRATERNITY assuring the dignity of the individual and the unity and integrity of the Nation; IN OUR CONSTITUENT ASSEMBLY this twenty-sixth day of November, 1949, do HEREBY ADOPT, ENACT AND GIVE TO OURSELVES THIS CONSTITUTION.`,
  },
  {
    tag: 'Constitution of India',
    title: 'Article 14',
    body: `The State shall not deny to any person equality before the law or the equal protection of the laws within the territory of India.`,
  },
  {
    tag: 'United Nations',
    title: 'Article 1 of the Universal Declaration of Human Rights',
    body: `All human beings are born free and equal in dignity and rights.`,
  },
  {
    tag: 'Speech',
    title: "Dr. B. R. Ambedkar's speech — 25th November 1949",
    body: `The third thing we must do is not to be content with mere political democracy. We must make our political democracy a social democracy as well. Political democracy cannot last unless there lies at the base of it social democracy. What does social democracy mean? It means a way of life which recognizes liberty, equality and fraternity as the principles of life. These principles of liberty, equality and fraternity are not to be treated as separate items in a trinity. They form a union of trinity in the sense that to divorce one from the other is to defeat the very purpose of democracy. Liberty cannot be divorced from equality, equality cannot be divorced from liberty. Nor can liberty and equality be divorced from fraternity. Without equality, liberty would produce the supremacy of the few over the many. Equality without liberty would kill individual initiative. Without fraternity, liberty and equality could not become a natural course of things. We must begin by acknowledging the fact that there is complete absence of two things in Indian society. One of these is equality. On the social plane, we have in India a society based on the principle of graded inequality — elevation for some and degradation for others. On the economic plane, we have a society in which there are some who have immense wealth as against many who live in abject poverty. On the 26th of January 1950, we are going to enter into a life of contradictions. In politics we will have equality and in social and economic life we will have inequality. How long shall we continue to live this life of contradictions? How long shall we continue to deny equality in our social and economic life? If we continue to deny it for long, we will do so only by putting our political democracy in peril.`,
  },
  {
    tag: 'Supreme Court of India',
    title: 'Indra Sawhney vs Union of India — 16 November 1992',
    body: `Para 340: Secularism is the basic feature of the Indian Constitution. It envisages a cohesive, unified and casteless society. The constitution has completely obliterated the caste system and has assured equality before law. References to caste under Article 15(2) and 16(2) is only to obliterate it. The prohibition on the ground of caste is total — the mandate is that never again in this country shall caste raise its head.\n\nPara 341: The caste system which has been put in the grave by the framers of the constitution is trying to raise its ugly head in various forms. Caste poses a serious threat on secularism and, as a consequence, to the integrity of the country. Those who do not want to learn from the events of history are doomed to suffer again.`,
  },
];
---

<Layout title="Our Obligation — Brihati Reforms Foundation">
  <PageHero
    eyebrow="What Binds Us"
    title="Our obligation is not optional."
    lede="These documents and voices define what we are bound to as citizens, as a republic, and as human beings. They are the compass for every step the foundation takes."
  />

  <section class="oblig-sec">
    <div class="container">
      <p class="intro">
        We at Brihati Reforms Foundation truly believe that we are all under obligation to work toward an egalitarian society. The following are the major documents and declarations that bind us — and inspire us to take every step possible to improve the lives of our fellow citizens.
      </p>

      <div class="oblig-list">
        {obligations.map((o) => (
          <article class="oblig-card">
            <span class="tag">{o.tag}</span>
            <h3>{o.title}</h3>
            {o.body.split('\n\n').map((para) => <p>{para}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .oblig-sec { background: var(--color-bg); }

  .intro {
    max-width: 780px;
    margin: 0 auto 56px;
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-ink-soft);
  }

  .oblig-list {
    display: grid;
    gap: 28px;
    max-width: 900px;
    margin: 0 auto;
  }
  .oblig-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: 36px 40px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .oblig-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

  .tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 10px;
  }
  .oblig-card h3 {
    font-size: 1.4rem;
    margin-bottom: 18px;
  }
  .oblig-card p {
    text-align: justify;
    line-height: 1.75;
    font-size: 1rem;
  }
  .oblig-card p:last-child { margin-bottom: 0; }

  @media (max-width: 600px) {
    .oblig-card { padding: 28px 24px; }
  }
</style>
