---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Donate — Brihati Reforms Foundation">
  <PageHero
    eyebrow="Stand With Us"
    title="Your support fuels the work."
    lede="Every contribution — however small — helps us run programmes, publish resources, and reach communities that need it most. Choose whichever option is easiest for you."
  />

  <section class="donate-sec">
    <div class="container">
      <div class="donate-grid">
        <!-- Bank -->
        <article class="donate-card">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 10l9-6 9 6" />
              <path d="M5 10v9" />
              <path d="M19 10v9" />
              <path d="M9 10v9" />
              <path d="M15 10v9" />
              <path d="M3 21h18" />
            </svg>
          </div>
          <span class="role">Bank Transfer</span>
          <h3>Account Transfer</h3>
          <dl>
            <div><dt>Account Name</dt><dd>Brihati Reforms Foundation</dd></div>
            <div><dt>Account No.</dt><dd><code>1167102100000524</code></dd></div>
            <div><dt>IFSC Code</dt><dd><code>PUNB0116710</code></dd></div>
            <div><dt>Branch</dt><dd>Sec-13, Hisar, Haryana</dd></div>
          </dl>
        </article>

        <!-- QR -->
        <article class="donate-card featured">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20v1" />
            </svg>
          </div>
          <span class="role">Scan to Pay</span>
          <h3>UPI QR Code</h3>
          <p>Scan with any UPI-based app — Google Pay, PhonePe, Paytm, or your bank's app.</p>
          <div class="qr">
            <img src="/images/brfqrcode.jpg" alt="BRF UPI QR code" loading="lazy" />
          </div>
        </article>

        <!-- UPI -->
        <article class="donate-card">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="3" />
              <line x1="12" y1="18" x2="12" y2="18" />
            </svg>
          </div>
          <span class="role">UPI ID</span>
          <h3>Pay via UPI</h3>
          <p>Send directly to our UPI ID from any UPI-based app.</p>
          <div class="upi-id">
            <code>7988948085m@pnb</code>
          </div>
          <p class="small">Tap and hold to copy the UPI ID.</p>
        </article>
      </div>

      <div class="donate-note">
        <p>
          Thank you for standing with us. For receipts, acknowledgements, or any questions about your contribution, please <a href="/contact/">get in touch</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .donate-sec { background: var(--color-bg); }
  .donate-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .donate-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: var(--shadow-sm);
  }
  .donate-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent-soft);
  }
  .donate-card.featured {
    background: linear-gradient(135deg, #ffffff 0%, #fff8ef 100%);
    border-color: var(--color-accent-soft);
  }

  .icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--color-bg-alt);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .icon svg { width: 26px; height: 26px; }
  .donate-card.featured .icon {
    background: var(--color-accent);
    color: #fff;
  }

  .donate-card .role {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .donate-card h3 { margin: 0 0 6px; font-size: 1.4rem; }

  dl { margin: 10px 0 0; display: flex; flex-direction: column; gap: 14px; }
  dl > div { display: flex; flex-direction: column; gap: 2px; }
  dt { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-muted); font-weight: 600; }
  dd { margin: 0; font-size: 1rem; color: var(--color-ink); }
  code {
    font-family: 'SF Mono', Monaco, Consolas, monospace;
    font-size: 0.95rem;
    background: var(--color-bg-alt);
    padding: 2px 8px;
    border-radius: 4px;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  .qr {
    margin-top: 16px;
    padding: 16px;
    background: #fff;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
  }
  .qr img { max-width: 220px; width: 100%; height: auto; }

  .upi-id {
    margin: 12px 0 4px;
    padding: 14px 18px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--color-border);
    text-align: center;
  }
  .upi-id code { background: transparent; padding: 0; font-size: 1.05rem; font-weight: 600; }
  .small { font-size: 0.82rem; color: var(--color-ink-muted); margin: 0; }

  .donate-note {
    max-width: 640px;
    margin: 56px auto 0;
    text-align: center;
    color: var(--color-ink-muted);
  }

  @media (max-width: 960px) {
    .donate-grid { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }
  }
</style>
